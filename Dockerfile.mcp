# MCP server for the dashboard API. Separate from the game-server image: it only
# needs Python and the MCP SDK, not Proton or SteamCMD.
FROM python:3.12-slim

RUN pip install --no-cache-dir "mcp>=2.0.0"

WORKDIR /opt/acevo-mcp
COPY mcp-server/acevo_mcp.py ./

ENV ACEVO_MCP_TRANSPORT=streamable-http \
    ACEVO_MCP_HOST=0.0.0.0 \
    ACEVO_MCP_PORT=3200 \
    ACEVO_MCP_PATH=/mcp

EXPOSE 3200
CMD ["python", "acevo_mcp.py"]
